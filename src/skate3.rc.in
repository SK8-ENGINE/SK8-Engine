1 VERSIONINFO
 FILEVERSION @SKATE3_RC_VERSION@
 PRODUCTVERSION @SKATE3_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Skate 3 Custom Engine Layer project"
            VALUE "FileDescription", "Skate 3 Custom Engine Layer"
            VALUE "FileVersion", "@SKATE3_FULL_VERSION@"
            VALUE "InternalName", "skate3"
            VALUE "LegalCopyright", "(c) Skate3Recomp and Skate 3 Custom Engine Layer contributors"
            VALUE "OriginalFilename", "skate3.exe"
            VALUE "ProductName", "Skate 3 Custom Engine Layer"
            VALUE "ProductVersion", "@SKATE3_FULL_VERSION@"
            VALUE "Comments", "Fan-made recompilation. Not affiliated with or endorsed by Electronic Arts."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
